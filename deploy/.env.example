# Copy to deploy/.env and fill in. That file is gitignored and must never be
# committed — these are real secrets for whatever environment you run.
#
# Generate each value with:
#   python netbox/generate_secret_key.py
#
# docker compose reads deploy/.env automatically when you run it as
#   docker compose -f deploy/docker-compose.yml up -d --build

# Signs sessions, password-reset tokens and CSRF tokens. 50+ characters.
SECRET_KEY=

# Hashes v2 API tokens. 50+ characters. Rotating it invalidates existing tokens.
API_TOKEN_PEPPER_1=

# Initial superuser created on first start.
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=admin@code.sa
SUPERUSER_PASSWORD=
